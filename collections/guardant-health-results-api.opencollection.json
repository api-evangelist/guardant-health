{
  "opencollection": "1.0.0",
  "info": {
    "name": "Guardant Health EMR Integration API (Illustrative Model) Orders Results API",
    "version": "0.1"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://example.invalid/guardant-health/oauth/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Results",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve results for an order",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://example.invalid/guardant-health/emr/orders/:orderId/results",
            "params": [
              {
                "name": "orderId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Illustrative representation of retrieving molecular profiling results for a completed order, delivered into the patient chart. Not a confirmed public endpoint."
        }
      ]
    }
  ],
  "bundled": true
}